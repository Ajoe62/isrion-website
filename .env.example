# Copy to .env for local development. Real values live in Vercel project settings.
# See "Newsletter (Brevo)" and "Contact form" in README.md.

# Brevo (newsletter and contact form)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_REDIRECT_URL=http://localhost:4321/news?subscribed=1#subscribe

# Contact form
CONTACT_TO=support@isrioninternational.com
CONTACT_FROM=support@isrioninternational.com

# Cloudflare Turnstile. These are Cloudflare's official test keys, which always
# pass; use the real keys from the Turnstile dashboard in Vercel.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
