---
// Contact form. Posts to /api/contact (src/pages/api/contact.ts), which emails
// the enquiry to the team through Brevo and sends the visitor an
// acknowledgement. Cloudflare Turnstile blocks bots; `_gotcha` is a honeypot.
// The Turnstile site key is public and baked in at build time.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---
<form method="POST" action="/api/contact" class="contact-form" data-reveal id="contactForm" novalidate>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

  <div class="row2">
    <label>Name<input type="text" name="name" required maxlength="100" autocomplete="name" /></label>
    <label>Email<input type="email" name="email" required maxlength="254" autocomplete="email" /></label>
  </div>
  <label>Organisation<input type="text" name="organisation" maxlength="150" autocomplete="organization" /></label>
  <label>How can we help?<textarea name="message" rows="5" required maxlength="5000"></textarea></label>
  {siteKey && <div class="turnstile" data-sitekey={siteKey}></div>}
  <button type="submit" class="btn btn-primary">Send message
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  <p class="form-status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id: string) => void;
    getResponse: (id: string) => string | undefined;
  };
  const w = window as unknown as { turnstile?: Turnstile };

  // Load Turnstile once per visit, in explicit mode, so the widget can be
  // rendered again after each ClientRouter navigation.
  let turnstileReady: Promise<Turnstile> | null = null;
  function loadTurnstile(): Promise<Turnstile> {
    if (w.turnstile) return Promise.resolve(w.turnstile);
    turnstileReady ??= new Promise((resolve, reject) => {
      const s = document.createElement("script");
      s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      s.async = true;
      s.onload = () => (w.turnstile ? resolve(w.turnstile) : reject(new Error("Turnstile missing")));
      s.onerror = () => { turnstileReady = null; reject(new Error("Turnstile failed to load")); };
      document.head.appendChild(s);
    });
    return turnstileReady;
  }

  function wireContactForm() {
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    if (!form || form.dataset.wired) return;
    form.dataset.wired = "true";
    const status = form.querySelector<HTMLElement>(".form-status");
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const box = form.querySelector<HTMLElement>(".turnstile");
    const show = (msg: string, ok: boolean) => {
      if (!status) return;
      status.hidden = false;
      status.textContent = msg;
      status.classList.toggle("ok", ok);
      status.classList.toggle("err", !ok);
    };

    let ts: Turnstile | null = null;
    let widgetId: string | null = null;
    if (box) {
      loadTurnstile()
        .then((t) => {
          ts = t;
          widgetId = t.render(box, { sitekey: box.dataset.sitekey, theme: "dark" });
        })
        .catch(() => show("The spam check couldn't load. Please refresh the page, or email us directly.", false));
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]")]
        .find((el) => !el.checkValidity());
      if (invalid) {
        show(invalid.type === "email" ? "Please enter a valid email address." : "Please fill in the required fields.", false);
        invalid.focus();
        return;
      }
      if (box && !(ts && widgetId && ts.getResponse(widgetId))) {
        show("Please complete the verification check above the button.", false);
        return;
      }
      if (btn) { btn.disabled = true; btn.dataset.label = btn.innerHTML; btn.textContent = "Sending…"; }
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data?.ok) {
          form.reset();
          show(data.message, true);
        } else {
          show(data?.message || "Something went wrong. Please email us directly.", false);
        }
      } catch {
        show("Network error. Please email us directly.", false);
      } finally {
        // Turnstile tokens are single use; get a fresh one for any retry.
        if (ts && widgetId) ts.reset(widgetId);
        if (btn) { btn.disabled = false; btn.innerHTML = btn.dataset.label || "Send message"; }
      }
    });
  }
  wireContactForm();
  document.addEventListener("astro:page-load", wireContactForm);
</script>

<style>
  .contact-form{display:grid;gap:1.1rem}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem}
  .contact-form label{display:grid;gap:.45rem;font-family:"Space Mono",monospace;font-size:.66rem;
    letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.8)}
  .contact-form input,.contact-form textarea{font-family:"Manrope";font-size:1rem;color:#fff;
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.22);border-radius:12px;
    padding:.85rem 1rem;letter-spacing:0;text-transform:none;transition:border-color .25s,background .25s}
  .contact-form input:focus,.contact-form textarea:focus{outline:none;border-color:#fff;background:rgba(255,255,255,.14)}
  .contact-form textarea{resize:vertical;min-height:120px}
  .contact-form button{justify-self:start;margin-top:.4rem}
  .turnstile{min-height:65px}
  .contact-form button:disabled{opacity:.65;cursor:default}
  .form-status{font-family:"Manrope";font-size:.92rem;letter-spacing:0;text-transform:none;margin-top:.2rem}
  .form-status.ok{color:#bff3d4}
  .form-status.err{color:#ffc9c9}
  @media(max-width:560px){.row2{grid-template-columns:1fr}}
</style>
