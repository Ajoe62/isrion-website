---
// Share row for articles and events. Plain links, so they work without JS;
// "Copy link" is the one button and is wired up in src/scripts/newsroom.ts.
interface Props { url: string; title: string; }
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    icon: "M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.84-2 3.8-2 4 0 4.75 2.6 4.75 6V21H19v-5c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6V21h-4z",
  },
  {
    label: "X",
    href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`,
    icon: "M18 2h3l-7 8 8 12h-6l-5-7-5 7H2l8-9L2 2h6l4 6zm-1 18h2L7 4H5z",
  },
  {
    label: "WhatsApp",
    href: `https://wa.me/?text=${t}%20${u}`,
    icon: "M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3a.4.4 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.2c-.1-.2-.3-.2-.6-.4z",
  },
  {
    label: "Email",
    href: `mailto:?subject=${t}&body=${u}`,
    icon: "M3 5h18v14H3zM3 6l9 7 9-7",
    stroke: true,
  },
];
---
<div class="share">
  <div class="share-row">
    {links.map((l) => (
      <a href={l.href} target={l.label === "Email" ? undefined : "_blank"} rel="noopener noreferrer"
         aria-label={`Share on ${l.label}`} title={`Share on ${l.label}`}>
        {l.stroke ? (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d={l.icon}/></svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={l.icon}/></svg>
        )}
      </a>
    ))}
    <button type="button" data-copy-link={url} aria-label="Copy link" title="Copy link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/>
      </svg>
    </button>
  </div>
  <p class="share-status" data-share-status aria-live="polite"></p>
</div>
