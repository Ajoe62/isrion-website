---
// Cartography gallery for the "Our Works" page.
//
// Images live in src/assets/maps/ so Astro's image pipeline (sharp) converts
// them to WebP, builds a responsive srcset and emits them into /_astro/, which
// both netlify.toml and vercel.json already cache immutable. The raw exports
// here are up to ~10,500px wide and 2 MB each, so shipping them from public/
// verbatim would not be viable.
//
// Each series is one row card in the same language as the project rows above:
// text on the left, the active plate on the right, thumbnails beneath it to
// switch plates. Maps render *whole* (object-fit: contain) rather than cropped:
// the legend carries the meaning, so cropping it would destroy the plate.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { mapSeries, type MapWork } from "../data/maps";

// Resolve every file in the folder at build time, then match by filename.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/maps/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

const resolvePlate = async (m: MapWork) => {
  const entry = files[`../assets/maps/${m.file}`];
  if (!entry) {
    throw new Error(
      `[MapGallery] src/assets/maps/${m.file} not found. ` +
        `Check the \`file\` value in src/data/maps.ts against the actual filename.`,
    );
  }
  const src = entry.default;
  // Larger render for the lightbox, where the reader is inspecting detail.
  // sharp never enlarges, so smaller exports simply keep their own width.
  const full = await getImage({ src, width: 2000, format: "webp", quality: 62 });
  return { ...m, src, full: full.src, ratio: src.width / src.height };
};

const series = await Promise.all(
  mapSeries.map(async (s) => {
    const plates = await Promise.all(s.plates.map(resolvePlate));
    // One frame per series, shaped by its tallest plate, so switching plates
    // never resizes the card. Wider plates letterbox into the white mount.
    const frame = Math.min(...plates.map((p) => p.ratio));
    // Thumbnails read "CH4 2020" when years tell the plates apart, otherwise
    // they fall back to the plate's own label ("Jones Creek").
    const yearsVary = new Set(plates.map((p) => p.year)).size > 1;
    const coverage = [...new Set(plates.map((p) => p.extent))].join("; ");
    return { ...s, plates, frame, yearsVary, coverage };
  }),
);

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<section class="maps-section">
  <div class="wrap">
    <header class="maps-head">
      <span class="eyebrow on-dark" data-reveal>Cartography</span>
      <h2 data-reveal>Places and hazards, mapped.</h2>
      <p data-reveal>
        Maps and spatial analyses from our environmental and geospatial work, from national
        pollution surfaces and satellite flood mapping to site-level sampling designs. Use the
        thumbnails to move through each series, or select a map to open it full size.
      </p>
    </header>

    <div class="map-rows">
      {series.map((s, si) => (
        <article
          class="map-row"
          id={s.id}
          data-map-row
          data-reveal
          style={`--frame:${s.frame.toFixed(4)};--n:${s.plates.length}`}
        >
          <div class="map-row-text">
            <div class="map-row-top">
              <span class="idx">{pad(si)}</span>
              <span class="cat">{s.label}</span>
            </div>
            <h3>{s.title}</h3>
            <p class="map-row-intro">{s.intro}</p>

            <div class="map-captions">
              {s.plates.map((m, i) => (
                <div
                  class:list={["map-caption", { "is-active": i === 0 }]}
                  id={`${s.id}-cap-${i}`}
                  role="tabpanel"
                  aria-labelledby={`${s.id}-tab-${i}`}
                  data-plate={i}
                  style={`--accent:${m.accent}`}
                >
                  <div class="map-caption-head">
                    <span class="map-chip">{m.chip}</span>
                    <span class="map-name">{m.label}</span>
                    {m.year && <span class="map-year">{m.year}</span>}
                  </div>
                  <h4>{m.title}</h4>
                  <p>{m.description}</p>
                  <div class="map-spec"><span>{m.stat}</span></div>
                  <div class="map-tags">{m.tags.map((t) => <span>{t}</span>)}</div>
                </div>
              ))}
            </div>

            <dl class="map-meta">
              <div><dt>Plates</dt><dd>{s.plates.length}</dd></div>
              <div><dt>Coverage</dt><dd>{s.coverage}</dd></div>
              {s.period && <div><dt>Period</dt><dd>{s.period}</dd></div>}
            </dl>
          </div>

          <div class="map-row-viewer">
            <div class="map-stage">
              {s.plates.map((m, i) => (
                <button
                  class="map-plate"
                  type="button"
                  hidden={i !== 0}
                  data-plate={i}
                  data-map-open
                  data-full={m.full}
                  data-title={m.year ? `${m.title} (${m.year})` : m.title}
                  data-desc={m.description}
                  data-range={m.stat}
                  aria-label={`Open ${m.title}${m.year ? ` (${m.year})` : ""} at full size`}
                >
                  <Image
                    src={m.src}
                    alt={m.alt}
                    width={1280}
                    widths={[640, 960, 1280]}
                    sizes="(max-width:900px) 92vw, 640px"
                    format="webp"
                    quality={78}
                    loading="lazy"
                  />
                  <span class="map-expand" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                    </svg>
                    View full map
                  </span>
                </button>
              ))}
            </div>

            <div class="map-thumbs" role="tablist" aria-label={`${s.title} plates`}>
              {s.plates.map((m, i) => (
                <button
                  class="map-thumb"
                  type="button"
                  role="tab"
                  id={`${s.id}-tab-${i}`}
                  aria-controls={`${s.id}-cap-${i}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-map-tab={i}
                  style={`--accent:${m.accent}`}
                >
                  <Image src={m.src} alt="" width={200} format="webp" quality={60} loading="lazy" />
                  <span>{s.yearsVary ? <>{`${m.chip} `}<b>{m.year}</b></> : m.label}</span>
                </button>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Full-size viewer. Native <dialog> gives a real focus trap + Esc for free. -->
<dialog class="map-lightbox" aria-label="Map viewer">
  <button class="ml-close" type="button" data-map-close aria-label="Close map viewer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6L6 18"/>
    </svg>
  </button>
  <figure>
    <div class="ml-stage">
      <img alt="" />
      <button class="ml-nav ml-prev" type="button" data-map-step="-1" aria-label="Previous map">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="ml-nav ml-next" type="button" data-map-step="1" aria-label="Next map">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
    <figcaption>
      <h3></h3>
      <p></p>
      <span class="ml-range"></span>
      <span class="ml-count"></span>
    </figcaption>
  </figure>
</dialog>

<script>
  // Delegated on `document` and registered once: the listeners outlive
  // ClientRouter view transitions, and rows and the dialog are re-queried per
  // event so they always target the current page's markup.
  declare global { interface Window { __lenis?: { stop(): void; start(): void } } }

  if (!(window as any).__mapGalleryBound) {
    (window as any).__mapGalleryBound = true;

    const dlg = () => document.querySelector<HTMLDialogElement>(".map-lightbox");
    // The series row the lightbox is browsing, for prev/next.
    let current: HTMLElement | null = null;

    const tabs = (row: HTMLElement) => [...row.querySelectorAll<HTMLElement>("[data-map-tab]")];
    const plates = (row: HTMLElement) => [...row.querySelectorAll<HTMLElement>("[data-map-open]")];
    const activeIndex = (row: HTMLElement) =>
      Math.max(0, tabs(row).findIndex((t) => t.getAttribute("aria-selected") === "true"));

    // Show plate i of a series: its map, its caption and its thumbnail state.
    // Inactive plates stay `hidden`, so their lazy images never download
    // until someone asks for them.
    const select = (row: HTMLElement, i: number) => {
      tabs(row).forEach((t, n) => {
        t.setAttribute("aria-selected", String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      row.querySelectorAll<HTMLElement>(".map-caption").forEach((c, n) => c.classList.toggle("is-active", n === i));
      plates(row).forEach((p, n) => (p.hidden = n !== i));
    };

    const show = (row: HTMLElement, i: number) => {
      const d = dlg();
      if (!d) return;
      const list = plates(row);
      const n = list.length;
      i = (i + n) % n;
      select(row, i); // keep the row in step, so closing lands on this plate
      current = row;

      const opener = list[i];
      const img = d.querySelector("img")!;
      img.src = opener.dataset.full || "";
      img.alt = opener.querySelector("img")?.alt || "";
      d.querySelector("figcaption h3")!.textContent = opener.dataset.title || "";
      d.querySelector("figcaption p")!.textContent = opener.dataset.desc || "";
      d.querySelector(".ml-range")!.textContent = opener.dataset.range || "";
      d.querySelector(".ml-count")!.textContent = n > 1 ? `${i + 1} / ${n}` : "";
      d.querySelectorAll<HTMLElement>(".ml-nav").forEach((b) => (b.hidden = n < 2));

      if (!d.open) {
        d.showModal();
        // Pause Lenis so the page doesn't drift behind the overlay; the
        // overflow lock covers the reduced-motion case where Lenis is absent.
        window.__lenis?.stop();
        document.documentElement.style.overflow = "hidden";
      }
    };

    const step = (by: number) => {
      if (current && dlg()?.open) show(current, activeIndex(current) + by);
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const row = target.closest<HTMLElement>("[data-map-row]");

      const tab = target.closest<HTMLElement>("[data-map-tab]");
      if (tab && row) return select(row, Number(tab.dataset.mapTab));

      const opener = target.closest<HTMLElement>("[data-map-open]");
      if (opener && row) return show(row, plates(row).indexOf(opener));

      const nav = target.closest<HTMLElement>("[data-map-step]");
      if (nav) return step(Number(nav.dataset.mapStep));

      // Close button, or a click on the backdrop (target is the dialog itself).
      if (target.closest("[data-map-close]") || target.classList.contains("map-lightbox")) dlg()?.close();
    });

    document.addEventListener("keydown", (e) => {
      if (dlg()?.open) {
        if (e.key === "ArrowLeft") step(-1);
        if (e.key === "ArrowRight") step(1);
        return;
      }

      // Tablist keyboard pattern: arrows move between thumbnails, Home/End jump.
      const tab = (e.target as HTMLElement).closest?.<HTMLElement>("[data-map-tab]");
      const row = tab?.closest<HTMLElement>("[data-map-row]");
      if (!tab || !row) return;
      const n = tabs(row).length;
      const i = Number(tab.dataset.mapTab);
      const next =
        e.key === "ArrowRight" ? (i + 1) % n :
        e.key === "ArrowLeft" ? (i - 1 + n) % n :
        e.key === "Home" ? 0 :
        e.key === "End" ? n - 1 : -1;
      if (next < 0) return;
      e.preventDefault();
      select(row, next);
      tabs(row)[next].focus();
    });

    document.addEventListener("close", (e) => {
      if (!(e.target as HTMLElement)?.classList?.contains("map-lightbox")) return;
      window.__lenis?.start();
      document.documentElement.style.overflow = "";
      current = null;
      const img = (e.target as HTMLDialogElement).querySelector("img");
      if (img) img.src = ""; // release the 2000px decode
    }, true);
  }
</script>
