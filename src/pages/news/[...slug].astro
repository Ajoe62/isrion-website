---
// One page per Markdown file in src/content/news/. The filename becomes the
// URL, so news/kwara-flood-mapping.md is served at /news/kwara-flood-mapping/.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { company } from "../../data/site";

export async function getStaticPaths() {
  const items = await getCollection("news", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<"news"> };
const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(d);
---
<BaseLayout title={`${entry.data.title} | ${company.name}`} description={entry.data.summary}>
  <PageHero
    current="News & Events"
    eyebrow={entry.data.type}
    title={entry.data.title}
    subtitle={entry.data.summary}
  />

  <section class="article-section"><div class="wrap">
    <div class="article-meta" data-reveal>
      <span>{fmt(entry.data.date)}</span>
      {entry.data.eventDate && <span>Event: {fmt(entry.data.eventDate)}</span>}
      {entry.data.location && <span>{entry.data.location}</span>}
      {entry.data.tags.map((t) => <span>{t}</span>)}
    </div>

    {entry.data.cover && (
      <figure class="article-cover" data-reveal>
        <Image
          src={entry.data.cover}
          alt={entry.data.coverAlt ?? ""}
          width={1240}
          widths={[640, 960, 1240]}
          sizes="(max-width:900px) 92vw, 1240px"
          format="webp"
          loading="eager"
        />
      </figure>
    )}

    <div class="article-body" data-reveal><Content /></div>

    <div class="article-foot" data-reveal>
      <a class="arrow-link" href="/news">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="transform:rotate(180deg)"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        All news and events
      </a>
      {entry.data.external && (
        <a class="btn btn-ghost" href={entry.data.external.href} target="_blank" rel="noopener noreferrer">
          {entry.data.external.label}<span class="vis-hidden"> (opens in a new tab)</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      )}
    </div>
  </div></section>

  <section class="home-cta"><div class="wrap">
    <h2 data-reveal>Working on something similar?</h2>
    <p data-reveal>Tell us about your project and we'll outline how we would approach it.</p>
    <a href="/contact" class="btn btn-primary" data-reveal>Contact us
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div></section>
</BaseLayout>
