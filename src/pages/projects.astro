---
// Our Works: hero, an index bar, then two lists of project rows (ongoing, then
// completed) and a CTA. Every row opens the project's own page with its full
// gallery. Everything is built from src/data/projects.ts, so a new project
// appears here, in the index bar and on its own page automatically.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { company } from "../data/site";
import { ongoing, completed } from "../data/projects";
---
<BaseLayout
  title={`Our Works | ${company.name}`}
  description="Ongoing and completed environmental and geospatial projects by ISRION International Ltd, from national air quality mapping to community groundwater assessment."
>
  <PageHero
    current="Our Works"
    eyebrow="Projects"
    title="Work that holds up over the long term."
    subtitle="Field studies and spatial analyses from our environmental and geospatial practice, from national pollution mapping and satellite flood assessment to community groundwater monitoring."
    image="/img/projects-hero.jpg"
  />

  <!-- IN-PAGE INDEX -->
  <nav class="page-index" aria-label="On this page">
    <div class="wrap">
      {ongoing.length > 0 && <a href="#ongoing"><span class="n">{ongoing.length}</span>Ongoing</a>}
      <a href="#completed"><span class="n">{completed.length}</span>Worked on</a>
    </div>
  </nav>

  {ongoing.length > 0 && (
    <section class="services-list works-list" id="ongoing"><div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow" data-reveal>In progress</span>
          <h2 data-reveal>Ongoing projects.</h2>
        </div>
      </div>
      <div class="svc-rows">
        {ongoing.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div></section>
  )}

  <section class="services-list works-list works-done" id="completed"><div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow" data-reveal>Completed</span>
        <h2 data-reveal>Projects we've worked on.</h2>
      </div>
    </div>
    <div class="svc-rows">
      {completed.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </div></section>

  <!-- CTA -->
  <section class="home-cta"><div class="wrap">
    <h2 data-reveal>Want to discuss a similar project?</h2>
    <p data-reveal>We'll share relevant experience and outline how we'd approach your work.</p>
    <a href="/contact" class="btn btn-primary" data-reveal>Contact us
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div></section>
</BaseLayout>
