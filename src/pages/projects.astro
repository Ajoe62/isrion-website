---
// Our Works mirrors the Services page: hero, a numbered list, a secondary
// section (the map gallery) and a CTA. The index bar under the hero is built
// from the same data, so new projects and map series appear in it automatically.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MapGallery from "../components/MapGallery.astro";
import { company, projects } from "../data/site";
import { mapSeries } from "../data/maps";

const pad = (n: number) => String(n + 1).padStart(2, "0");
// "Flood hazard · Sentinel-1 SAR" reads as "Flood hazard" in the index bar.
const shortLabel = (label: string) => label.split(" · ")[0];
---
<BaseLayout title={`Our Works | ${company.name}`}>
  <PageHero
    current="Our Works"
    eyebrow="Projects"
    title="Work that holds up over the long term."
    subtitle="A selection of engagements across environmental, geospatial, energy and engineering domains. Representative examples; get in touch for sector-specific references."
    image="/img/projects-hero.jpg"
  />

  <!-- IN-PAGE INDEX -->
  <nav class="page-index" aria-label="On this page">
    <div class="wrap">
      <a href="#projects"><span class="n">{projects.length}</span>Projects</a>
      <span class="sep" aria-hidden="true"></span>
      <span class="page-index-label">Cartography</span>
      {mapSeries.map((s) => (
        <a href={`#${s.id}`}><span class="n">{s.plates.length}</span>{shortLabel(s.label)}</a>
      ))}
    </div>
  </nav>

  <!-- PROJECT LIST -->
  <section class="services-list works-list" id="projects"><div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow" data-reveal>Selected projects</span>
        <h2 data-reveal>Engagements, start to finish.</h2>
      </div>
    </div>
    <div class="svc-rows">
      {projects.map((p, i) => (
        <article class="svc-row work-row" data-reveal>
          <div class="svc-row-idx">
            <span class="idx">{pad(i)}</span>
            <span class="cat">{p.sector}</span>
            <dl class="work-meta">
              <div><dt>Year</dt><dd>{p.year}</dd></div>
              <div><dt>Location</dt><dd>{p.location}</dd></div>
            </dl>
          </div>
          <div class="svc-row-body">
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
          </div>
          <div class="work-thumb" data-sector={p.sector}>
            {p.image && <img src={p.image} alt="" loading="lazy" />}
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <MapGallery />

  <!-- CTA -->
  <section class="home-cta"><div class="wrap">
    <h2 data-reveal>Want to discuss a similar project?</h2>
    <p data-reveal>We'll share relevant experience and outline how we'd approach your work.</p>
    <a href="/contact" class="btn btn-primary" data-reveal>Contact us
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div></section>
</BaseLayout>
